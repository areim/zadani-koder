/ nav.navbar
  .navbar__content
    = link_to root_path, class: 'navbar__brand'
      = image_tag "fakturaonline_logo.svg", class: 'navbar__logo', alt: t('.logo_alt'), width: t('.logo_width'), height: t('.logo_height')
    ul.navbar-navigation
      span.navbar-cta = t('.free_in_30_seconds_html')
      = link_to_menu_item :li, t('.invoice'), root_path, class: 'el-button el-button--warning navbar-navigation__link--invoice', wrapper_options: { class: 'navbar-navigation__item navbar-navigation__item--new-invoice' }
  .container
    ul.navbar-navigation
      = link_to_menu_item :li, t('.news'), news_path
      = link_to_menu_item :li, t('.guides'), guides_path
      = link_to_menu_item :li, t('.support'), support_path
      = link_to_menu_item :li, t('.newsletter'), newsletter_path

==
<nav class="navbar">
  <div class="container">
    <div class="d-flex align-items-center w-100 navbar__claim-row">
      <!-- Logo on left -->
      <a class="navbar-brand" href="/">
        <img src="logo.svg" alt="Faktura Online.cz">
      </a>
      
      <!-- Claim in center -->
      <div class="navbar__claim">
        Vystavujte faktury zdarma za méně než 30 vteřin.
      </div>

      <!-- Buttons on right -->
      <div class="d-flex gap-2 ml-auto">
        <button class="el-button el-button--warning">
          <i class="icon"></i>
          <span class="d-none d-sm-inline">Vystavit fakturu</span>
        </button>
        <button class="el-button">
          <i class="icon"></i>
          <span class="d-none d-sm-inline">Přihlásit se</span>
        </button>
      </div>
    </div>
  </div>
  <div class="pb-3 w-100">
    <div class="container">
      <ul class="nav d-flex justify-content-center align-items-center w-100 font-weight-bold">
        <li>
          <a href="#">Novinky</a>
        </li>
        <li>
          <a href="#">Návody</a>
        </li>
        <li>
          <a href="#">Mám problém</a>
        </li>
        <li>
          <a href="#">Podnikatelský zpravodaj</a>
        </li>
      </ul>
    </div>
  </div>
</nav>